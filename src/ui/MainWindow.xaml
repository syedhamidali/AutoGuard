<Window x:Class="AutoPortal.Guardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AutoPortal.Guardian.App.Controls"
        Title="AutoPortal System Guardian" Width="1100" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,16">
                    <TextBlock Text="AutoPortal" FontSize="12" Style="{StaticResource Dim}"/>
                    <TextBlock Text="System Guardian" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="SensorMode" DockPanel.Dock="Bottom" Margin="16" TextWrapping="Wrap" Style="{StaticResource Dim}"/>
                <StackPanel x:Name="Nav" Margin="8,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20,16,10,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="Banner" Visibility="Collapsed" Background="#3a2a10" BorderBrush="#7a5a1a" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,10">
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="#ffd98a"/>
            </Border>

            <Grid Grid.Row="1">
                <!-- DASHBOARD -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Overall PC health" Style="{StaticResource Dim}"/>
                            <TextBlock x:Name="HealthText" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HealthDetail" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU temperature" Style="{StaticResource Dim}"/><TextBlock x:Name="TCpuT" FontSize="22"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GPU temperature" Style="{StaticResource Dim}"/><TextBlock x:Name="TGpuT" FontSize="22"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Motherboard" Style="{StaticResource Dim}"/><TextBlock x:Name="TMoboT" FontSize="22"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Fans" Style="{StaticResource Dim}"/><TextBlock x:Name="TFans" FontSize="14" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU usage" Style="{StaticResource Dim}"/><TextBlock x:Name="TCpuL" FontSize="22"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RAM usage" Style="{StaticResource Dim}"/><TextBlock x:Name="TRam" FontSize="22"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GPU usage" Style="{StaticResource Dim}"/><TextBlock x:Name="TGpuL" FontSize="22"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Stability (7 days)" Style="{StaticResource Dim}"/><TextBlock x:Name="TStab" FontSize="14" TextWrapping="Wrap"/></StackPanel></Border>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,10"><TextBlock Text="Temperatures" Style="{StaticResource Dim}"/><c:Sparkline x:Name="DashTemps" Height="140" Stroke="#ff7a59" Unit="°"/></StackPanel>
                            <StackPanel Margin="0,0,10,10"><TextBlock Text="CPU usage" Style="{StaticResource Dim}"/><c:Sparkline x:Name="DashLoad" Height="140" Stroke="#4aa3ff" Unit="%" FixedMax="100"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- THERMAL -->
                <ScrollViewer x:Name="PageThermal" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Thermal Monitor" Style="{StaticResource H1}"/>
                        <TextBlock Text="CPU temperature" Style="{StaticResource Dim}"/><c:Sparkline x:Name="ChCpuT" Height="120" Margin="0,0,10,10" Stroke="#ff7a59" Unit="°"/>
                        <TextBlock Text="GPU temperature" Style="{StaticResource Dim}"/><c:Sparkline x:Name="ChGpuT" Height="120" Margin="0,0,10,10" Stroke="#ffb454" Unit="°"/>
                        <TextBlock Text="GPU hotspot" Style="{StaticResource Dim}"/><c:Sparkline x:Name="ChGpuH" Height="120" Margin="0,0,10,10" Stroke="#ff5d8f" Unit="°"/>
                        <TextBlock Text="CPU fan (RPM)" Style="{StaticResource Dim}"/><c:Sparkline x:Name="ChFan" Height="120" Margin="0,0,10,10" Stroke="#6fd49b"/>
                        <TextBlock Text="Temperature warnings" Style="{StaticResource H1}" FontSize="16"/>
                        <ListBox x:Name="ThermalFindings" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" Margin="0,0,10,10"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- COOLING -->
                <ScrollViewer x:Name="PageCooling" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Cooling Management" Style="{StaticResource H1}"/>
                        <TextBlock Text="Detected fans (only what your hardware reports)" Style="{StaticResource Dim}"/>
                        <DataGrid x:Name="FanGrid" Height="170"/>
                        <TextBlock x:Name="FanControlInfo" TextWrapping="Wrap" Style="{StaticResource Dim}" Margin="0,0,10,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BtnRestoreFans" Content="Restore default fan control" Click="RestoreFans_Click"/>
                        </StackPanel>
                        <TextBlock Text="Example fan curve (an example only, not a universal recommendation)" Style="{StaticResource Dim}"/>
                        <DataGrid x:Name="CurveGrid" Height="170"/>
                        <TextBlock Text="Cooling observations" Style="{StaticResource H1}" FontSize="16"/>
                        <ListBox x:Name="CoolingList" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" MinHeight="60" Margin="0,0,10,10"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- PERFORMANCE -->
                <ScrollViewer x:Name="PagePerf" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Performance" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="PerfSummary" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="CPU usage" Style="{StaticResource Dim}"/><c:Sparkline x:Name="ChCpuL" Height="100" Margin="0,0,10,10" Stroke="#4aa3ff" Unit="%" FixedMax="100"/></StackPanel>
                            <StackPanel><TextBlock Text="RAM usage" Style="{StaticResource Dim}"/><c:Sparkline x:Name="ChRam" Height="100" Margin="0,0,10,10" Stroke="#b48cff" Unit="%" FixedMax="100"/></StackPanel>
                            <StackPanel><TextBlock Text="Disk usage" Style="{StaticResource Dim}"/><c:Sparkline x:Name="ChDisk" Height="100" Margin="0,0,10,10" Stroke="#6fd49b" Unit="%" FixedMax="100"/></StackPanel>
                            <StackPanel><TextBlock Text="GPU usage" Style="{StaticResource Dim}"/><c:Sparkline x:Name="ChGpuL" Height="100" Margin="0,0,10,10" Stroke="#ffb454" Unit="%" FixedMax="100"/></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Top by CPU" Style="{StaticResource Dim}"/><DataGrid x:Name="GridCpu" Height="170"/>
                        <TextBlock Text="Top by RAM" Style="{StaticResource Dim}"/><DataGrid x:Name="GridRam" Height="170"/>
                        <TextBlock Text="Top by disk activity" Style="{StaticResource Dim}"/><DataGrid x:Name="GridDisk" Height="170"/>
                        <TextBlock Text="Startup applications (inspect only; Guardian never kills processes automatically)" Style="{StaticResource Dim}"/><DataGrid x:Name="GridStartup" Height="220"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- HEALTH -->
                <ScrollViewer x:Name="PageHealth" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="System Health" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="HealthUnclean" TextWrapping="Wrap" Margin="0,0,10,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Generate diagnostic report…" Click="Report_Click"/>
                        </StackPanel>
                        <TextBlock Text="Windows events (last 7 days): crashes, hardware errors, driver and disk errors, unexpected shutdowns" Style="{StaticResource Dim}"/>
                        <DataGrid x:Name="EventGrid" Height="360"/>
                        <TextBlock Text="Drive health" Style="{StaticResource Dim}"/>
                        <DataGrid x:Name="DiskGrid" Height="120"/>
                        <TextBlock Text="Guardian's own log" Style="{StaticResource Dim}"/>
                        <DataGrid x:Name="OwnLog" Height="200"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- RECOMMENDATIONS -->
                <ScrollViewer x:Name="PageRecs" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Recommendations" Style="{StaticResource H1}"/>
                        <TextBlock Text="Possibilities are labeled as such. Each item lists the recorded evidence behind it." Style="{StaticResource Dim}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="RecList"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                        <CheckBox x:Name="SetStartup" Content="Start with Windows (Task Scheduler, minimized to tray)"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="Startup delay (seconds)" Width="230" VerticalAlignment="Center"/><TextBox x:Name="SetDelay"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="Monitoring interval (seconds)" Width="230" VerticalAlignment="Center"/><TextBox x:Name="SetInterval"/></StackPanel>
                        <CheckBox x:Name="SetNotify" Content="Show notifications for High / Critical conditions"/>
                        <CheckBox x:Name="SetRecovery" Content="Automatic recovery (resume monitoring after sleep)"/>
                        <TextBlock Text="Temperature thresholds (°C) - Elevated / High / Critical" Margin="0,12,0,4" Style="{StaticResource Dim}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="CPU" Width="100" VerticalAlignment="Center"/><TextBox x:Name="CpuE"/><TextBox x:Name="CpuH" Margin="6,0"/><TextBox x:Name="CpuC"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="GPU" Width="100" VerticalAlignment="Center"/><TextBox x:Name="GpuE"/><TextBox x:Name="GpuH" Margin="6,0"/><TextBox x:Name="GpuC"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="Motherboard" Width="100" VerticalAlignment="Center"/><TextBox x:Name="MbE"/><TextBox x:Name="MbH" Margin="6,0"/><TextBox x:Name="MbC"/></StackPanel>
                        <TextBlock Text="Data and privacy" Margin="0,14,0,4" Style="{StaticResource Dim}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="Keep history (days)" Width="230" VerticalAlignment="Center"/><TextBox x:Name="SetRetention"/></StackPanel>
                        <TextBlock Text="No telemetry. Nothing is uploaded. History is stored only on this PC." Style="{StaticResource Dim}" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14">
                            <Button Content="Save settings" Click="SaveSettings_Click"/>
                            <Button Content="Restart as administrator (full sensor access)" Click="Elevate_Click"/>
                            <Button Content="Delete diagnostic history…" Click="DeleteHistory_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SettingsMsg" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>

