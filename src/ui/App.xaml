<Application x:Class="AutoPortal.Guardian.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0f1217"/>
        <SolidColorBrush x:Key="Panel" Color="#171b22"/>
        <SolidColorBrush x:Key="Panel2" Color="#1b1f27"/>
        <SolidColorBrush x:Key="Border" Color="#2a303b"/>
        <SolidColorBrush x:Key="Text" Color="#e6e9ef"/>
        <SolidColorBrush x:Key="DimBrush" Color="#8b94a3"/>
        <SolidColorBrush x:Key="Accent" Color="#4aa3ff"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style x:Key="Dim" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource DimBrush}"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#242b36"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#10141a"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="4"/><Setter Property="Width" Value="70"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="RowBackground" Value="{StaticResource Panel}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#242b36"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="8,4"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    </Application.Resources>
</Application>

